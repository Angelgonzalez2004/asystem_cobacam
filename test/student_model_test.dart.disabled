void main() {
  group('Student', () {
    final mockStudentData = {
      'fullName': 'Angel Del Carmen Gonzalez Alcocer',
      'guardianFullName': 'Maria Alcocer',
      'age': 17,
      'guardianPhone': '9811234567',
      'studentPhone': '9817654321',
      'gender': 'Masculino',
      'placeOfResidence': 'Atasta',
      'schoolCycle': '2025-B',
      'group': '603',
      'institutionalEmail': 'angel.gonzalez@cobacam.edu.mx',
      'studentId': 'MAT603-001',
    };

    test('fromJson creates a valid Student object', () {
      final student = Student(
        id: 'testKey',
        fullName: mockStudentData['fullName'] as String,
        guardianFullName: mockStudentData['guardianFullName'] as String,
        age: mockStudentData['age'] as int,
        guardianPhone: mockStudentData['guardianPhone'] as String,
        studentPhone: mockStudentData['studentPhone'] as String,
        gender: mockStudentData['gender'] as String,
        placeOfResidence: mockStudentData['placeOfResidence'] as String,
        schoolCycle: mockStudentData['schoolCycle'] as String,
        group: mockStudentData['group'] as String,
        institutionalEmail: mockStudentData['institutionalEmail'] as String,
        studentId: mockStudentData['studentId'] as String,
      );

      expect(student.fullName, 'Angel Del Carmen Gonzalez Alcocer');
      expect(student.studentId, 'MAT603-001');
      expect(student.age, 17);
      expect(student.schoolCycle, '2025-B');
    });

    test('fromSnapshot creates a valid Student object from DataSnapshot', () {
      final mockSnapshot = MockDataSnapshot('testKey', mockStudentData, MockDatabaseReference('/path/to/students/testKey'));
      final student = Student.fromSnapshot(mockSnapshot);

      expect(student.id, 'testKey');
      expect(student.fullName, 'Angel Del Carmen Gonzalez Alcocer');
      expect(student.studentId, 'MAT603-001');
      expect(student.age, 17);
      expect(student.schoolCycle, '2025-B');
    });

    test('toFirebaseMap converts Student object to correct Map', () {
      final student = Student(
        id: 'testKey',
        fullName: mockStudentData['fullName'] as String,
        guardianFullName: mockStudentData['guardianFullName'] as String,
        age: mockStudentData['age'] as int,
        guardianPhone: mockStudentData['guardianPhone'] as String,
        studentPhone: mockStudentData['studentPhone'] as String,
        gender: mockStudentData['gender'] as String,
        placeOfResidence: mockStudentData['placeOfResidence'] as String,
        schoolCycle: mockStudentData['schoolCycle'] as String,
        group: mockStudentData['group'] as String,
        institutionalEmail: mockStudentData['institutionalEmail'] as String,
        studentId: mockStudentData['studentId'] as String,
      );

      final map = student.toFirebaseMap();

      expect(map['fullName'], 'Angel Del Carmen Gonzalez Alcocer');
      expect(map['studentId'], 'MAT603-001');
      expect(map['age'], 17);
      expect(map['schoolCycle'], '2025-B');
      expect(map.containsKey('id'), false); // 'id' should not be in the map, as it's the Firebase key
    });
  });
}
