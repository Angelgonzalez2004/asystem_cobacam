{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "asystemcobacam",
          "appId": "1:847754643180:android:26e661c1f8438cf9cdc7c9",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "asystemcobacam",
          "configurations": {
            "android": "1:847754643180:android:26e661c1f8438cf9cdc7c9",
            "ios": "1:847754643180:ios:3547f5e2af4281cbcdc7c9",
            "macos": "1:847754643180:ios:3547f5e2af4281cbcdc7c9",
